# Staging environment defaults (committed - no secrets here).
# Demoblaze exposes a single public environment, so the URLs match dev; in a real
# project point these at the staging deployment.
BASE_URL=https://www.demoblaze.com
API_BASE_URL=https://api.demoblaze.com
HEADLESS=true
LOCAL_RETRIES=1
CI_RETRIES=2
LOG_LEVEL=info
