# -----------------------------------------------------------------------------
# Local environment overrides - copy to `.env` (git-ignored) and adjust.
#
# Resolution order (highest wins):
#   1. Real process environment (CI secrets, `cross-env`, shell exports)
#   2. .env                              (local developer overrides, never committed)
#   3. environments/.env.<TEST_ENV>      (per-environment defaults, committed)
#   4. Defaults declared in src/config/env.schema.ts
# -----------------------------------------------------------------------------

# Target environment: dev | staging | prod  (selects environments/.env.<TEST_ENV>)
TEST_ENV=dev

# Application under test
BASE_URL=https://www.demoblaze.com
API_BASE_URL=https://api.demoblaze.com

# Shared test account (secrets - inject from CI credential store in pipelines)
TEST_USERNAME=
TEST_PASSWORD=

# Browser
HEADLESS=true

# Timeouts (ms)
DEFAULT_TIMEOUT=60000
ACTION_TIMEOUT=15000
NAVIGATION_TIMEOUT=30000
EXPECT_TIMEOUT=10000

# Retries & parallelism
LOCAL_RETRIES=0
CI_RETRIES=2
# WORKERS accepts a number or a percentage, e.g. 4 or 50%
WORKERS=

# Test selection (regex passed to --grep / --grep-invert), e.g. @smoke|@regression
TEST_TAGS=
EXCLUDE_TAGS=

# Artifact folder for traces/videos/screenshots (relative to the project root or absolute).
# Keep it outside cloud-synced folders (Google Drive, OneDrive) on Windows: sync file locks can
# stall Playwright's artifact cleanup and worker shutdown.
OUTPUT_DIR=test-results

# Artifacts: off | on | retain-on-failure | on-first-retry (screenshot: off | on | only-on-failure)
TRACE_MODE=retain-on-failure
VIDEO_MODE=retain-on-failure
SCREENSHOT_MODE=only-on-failure

# Logging: debug | info | warn | error ; format: pretty | json
LOG_LEVEL=info
LOG_FORMAT=pretty

# API client
API_RETRIES=2
API_TIMEOUT=15000

# Database (optional - only used by src/db when DB_TYPE is set): postgres | mysql | mongo
DB_TYPE=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CONNECTION_STRING=
